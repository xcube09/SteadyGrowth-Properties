@page
@model SteadyGrowth.Web.Areas.Identity.Pages.RegistrationPendingModel
@{
    ViewData["Title"] = "Registration Pending";
}

<div class="ltn__login-area pb-110">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title">Registration <br>Submitted Successfully!</h1>
                    <p>
                        Thank you for registering with SteadyGrowth. <br>
                        Please complete your payment to activate your account.
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                @if (Model.RegistrationFound)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fa fa-info-circle me-2"></i>Your Registration Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Email:</strong> @Model.Email</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Selected Package:</strong> @Model.PackageName</p>
                                </div>
                            </div>
                            <div class="alert alert-info mb-0">
                                <h5 class="alert-heading">Amount Due: <strong>$@Model.PackagePrice.ToString("N0")</strong></h5>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fa fa-credit-card me-2"></i>Payment Instructions</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-3">Please make your payment using one of the following methods:</p>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-header bg-light">
                                            <strong>Stanbic IBTC Bank</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-1"><strong>Account Name:</strong> SteadyGrowth Ltd</p>
                                            <p class="mb-1"><strong>Account Number:</strong> 0012345678</p>
                                            <p class="mb-0"><strong>Bank:</strong> Stanbic IBTC</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-header bg-light">
                                            <strong>United Bank for Africa (UBA)</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-1"><strong>Account Name:</strong> SteadyGrowth Ltd</p>
                                            <p class="mb-1"><strong>Account Number:</strong> 2098765432</p>
                                            <p class="mb-0"><strong>Bank:</strong> UBA</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-3">
                                <h6 class="alert-heading"><i class="fa fa-exclamation-triangle me-2"></i>Important:</h6>
                                <ul class="mb-0">
                                    <li>Use your email (<strong>@Model.Email</strong>) as the payment reference</li>
                                    <li>After payment, send proof of payment via WhatsApp for faster processing</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0"><i class="fa fa-whatsapp me-2"></i>Contact Us</h5>
                        </div>
                        <div class="card-body">
                            <p>After making payment, please send your proof of payment to:</p>
                            <div class="d-flex align-items-center">
                                <a href="https://wa.me/2348026744139" class="btn btn-success btn-lg" target="_blank">
                                    <i class="fa fa-whatsapp me-2"></i>WhatsApp: +234 802 674 4139
                                </a>
                            </div>
                            <p class="mt-3 text-muted small">
                                Our team will verify your payment and activate your account within 24 hours.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        <h5>Registration Not Found</h5>
                        <p>We couldn't find your pending registration. Please try registering again.</p>
                        <a asp-page="/Register" class="btn btn-primary">Register Again</a>
                    </div>
                }

                <div class="text-center mt-4">
                    <p>Already completed payment and account activated?</p>
                    <a asp-page="/Login" class="btn btn-outline-primary">
                        <i class="fa fa-sign-in me-2"></i>Go to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
