@page
@model SteadyGrowth.Web.Areas.Identity.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    input[type="text"], input[type="email"], input[type="password"], input[type="submit"], textarea {

        margin-bottom: 0px;
    }

    div.form-group{
        margin-bottom:30px!important;
    }

    .package-card {
        transition: all 0.2s ease;
        border: 2px solid #e9ecef;
    }

    .package-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.15);
    }

    .package-card.border-primary {
        border-color: #0d6efd !important;
        background-color: #f8f9ff;
    }

    .package-card .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.25em;
    }

    .package-card .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>

<div class="ltn__login-area pb-110">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title">Register <br>Your Account</h1>
                    <p>
                        Create your SteadyGrowth Account to gain Access to Practical knowledge, skillsets and mindset to build sustainable wealth through Real estate.<br>
                        Join our growing community and start your Journey to Financial growth today.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="account-login-inner">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form method="post" class="ltn__form-box contact-form-box">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-group">
                            <input asp-for="FirstName" class="form-control" placeholder="First Name*" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="LastName" class="form-control" placeholder="Last Name*" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="Email" class="form-control" placeholder="Email*" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="PhoneNumber" type="text" class="form-control" placeholder="Phone Number (optional)" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            @if (!string.IsNullOrWhiteSpace(Model.ReferralCode))
                            {
                                <input asp-for="ReferralCode" class="form-control" placeholder="Referral Code" readonly />
                            }
                            else
                            {
                                <input asp-for="ReferralCode" class="form-control" placeholder="Referral Code (optional)" />
                            }
                            <span asp-validation-for="ReferralCode" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="Password" class="form-control" placeholder="Password*" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password*" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Package Selection -->
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold mb-3">Select Your Package *</label>
                            <div class="row">
                                @foreach (var package in Model.AvailablePackages)
                                {
                                    <div class="col-12 mb-3">
                                        <div class="card package-card @(Model.SelectedPackageId == package.Id ? "border-primary" : "")" style="cursor: pointer;">
                                            <div class="card-body p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio"
                                                           name="SelectedPackageId"
                                                           id="package_@package.Id"
                                                           value="@package.Id"
                                                           @(Model.SelectedPackageId == package.Id ? "checked" : "") />
                                                    <label class="form-check-label w-100" for="package_@package.Id">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <strong class="fs-5">@package.Name</strong>
                                                                @if (!string.IsNullOrWhiteSpace(package.Description))
                                                                {
                                                                    <p class="text-muted mb-0 small">@package.Description</p>
                                                                }
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="badge bg-primary fs-6">$@package.Price.ToString("N0")</span>
                                                            </div>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="SelectedPackageId" class="text-danger"></span>
                            <small class="text-muted">Your package will be activated after payment confirmation by admin.</small>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="Consent1" class="form-check-input" />
                            <label asp-for="Consent1" class="form-check-label">
                                I consent to SteadyGrowth processing my personal data in order to send personalized marketing material in accordance with the consent form and the privacy policy.
                            </label>
                            <span asp-validation-for="Consent1" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Consent2" class="form-check-input" />
                            <label asp-for="Consent2" class="form-check-label">
                                By clicking "create account", I consent to the privacy policy.
                            </label>
                            <span asp-validation-for="Consent2" class="text-danger"></span>
                        </div>

                        <div class="btn-wrapper">
                            <button id="submitBtn" class="theme-btn-1 btn reverse-color btn-block" type="submit">
                                <span id="btnText">SUBMIT REGISTRATION</span>
                                <span id="btnSpinner" style="display:none;">
                                    <i class="fa fa-spinner fa-spin"></i> Submitting...
                                </span>
                            </button>
                        </div>

                    </form>

                    <div class="by-agree text-center">
                        <p>By creating an account, you agree to our:</p>
                        <p><a href="#">TERMS OF CONDITIONS  &nbsp; &nbsp; | &nbsp; &nbsp;  PRIVACY POLICY</a></p>
                        <div class="go-to-btn mt-50">
                            <a asp-area="Identity" asp-page="/Login">ALREADY HAVE AN ACCOUNT?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Package card click handling
            $('.package-card').on('click', function() {
                var radio = $(this).find('input[type="radio"]');
                radio.prop('checked', true);

                // Update visual selection
                $('.package-card').removeClass('border-primary');
                $(this).addClass('border-primary');
            });

            // Form submission handling
            $('form').on('submit', function(e) {
                var form = this;
                var submitBtn = $('#submitBtn');

                // Check if form is valid (using jQuery validation if present)
                if (typeof $(form).valid === 'function' && !$(form).valid()) {
                    return false;
                }

                // Prevent double submission
                if (submitBtn.prop('disabled')) {
                    e.preventDefault();
                    return false;
                }

                // Disable button and show loading state
                submitBtn.prop('disabled', true);
                $('#btnText').hide();
                $('#btnSpinner').show();

                // Allow form to submit
                return true;
            });
        });
    </script>
}