@page
@model SteadyGrowth.Web.Areas.Identity.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    input[type="text"], input[type="email"], input[type="password"], input[type="submit"], textarea {
        
        margin-bottom: 0px;
    }

    div.form-group{
        margin-bottom:30px!important;
    }
</style>

<div class="ltn__login-area pb-110">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title">Register <br>Your Account</h1>
                    <p>
                        Create your SteadyGrowth account to access exclusive property listings, manage your investments, and enjoy personalized real estate services.<br>
                        Join our community and start your journey to financial growth today.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="account-login-inner">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form method="post" class="ltn__form-box contact-form-box">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-group">
                            <input asp-for="FirstName" class="form-control" placeholder="First Name*" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="LastName" class="form-control" placeholder="Last Name*" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="Email" class="form-control" placeholder="Email*" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="PhoneNumber" type="text" class="form-control" placeholder="Phone Number (optional)" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            @if (!string.IsNullOrWhiteSpace(Model.ReferralCode))
                            {
                                <input asp-for="ReferralCode" class="form-control" placeholder="Referral Code" readonly />
                            }
                            else
                            {
                                <input asp-for="ReferralCode" class="form-control" placeholder="Referral Code (optional)" />
                            }
                            <span asp-validation-for="ReferralCode" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="Password" class="form-control" placeholder="Password*" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password*" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="Consent1" class="form-check-input" />
                            <label asp-for="Consent1" class="form-check-label">
                                I consent to SteadyGrowth processing my personal data in order to send personalized marketing material in accordance with the consent form and the privacy policy.
                            </label>
                            <span asp-validation-for="Consent1" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Consent2" class="form-check-input" />
                            <label asp-for="Consent2" class="form-check-label">
                                By clicking "create account", I consent to the privacy policy.
                            </label>
                            <span asp-validation-for="Consent2" class="text-danger"></span>
                        </div>

                        <div class="btn-wrapper">
                            <button id="submitBtn" class="theme-btn-1 btn reverse-color btn-block" type="submit">
                                <span id="btnText">CREATE ACCOUNT</span>
                                <span id="btnSpinner" style="display:none;">
                                    <i class="fa fa-spinner fa-spin"></i> Creating Account...
                                </span>
                            </button>
                        </div>

                    </form>

                    <div class="by-agree text-center">
                        <p>By creating an account, you agree to our:</p>
                        <p><a href="#">TERMS OF CONDITIONS  &nbsp; &nbsp; | &nbsp; &nbsp;  PRIVACY POLICY</a></p>
                        <div class="go-to-btn mt-50">
                            <a asp-area="Identity" asp-page="/Login">ALREADY HAVE AN ACCOUNT?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('form').on('submit', function(e) {
                var form = this;
                var submitBtn = $('#submitBtn');

                // Check if form is valid (using jQuery validation if present)
                if (typeof $(form).valid === 'function' && !$(form).valid()) {
                    return false;
                }

                // Prevent double submission
                if (submitBtn.prop('disabled')) {
                    e.preventDefault();
                    return false;
                }

                // Disable button and show loading state
                submitBtn.prop('disabled', true);
                $('#btnText').hide();
                $('#btnSpinner').show();

                // Allow form to submit
                return true;
            });
        });
    </script>
}