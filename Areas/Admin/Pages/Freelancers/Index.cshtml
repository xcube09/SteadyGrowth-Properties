@page
@model SteadyGrowth.Web.Areas.Admin.Pages.Freelancers.IndexModel
@using SteadyGrowth.Web.Models.Enums
@{
    ViewData["Title"] = "Freelancer Applications";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
@if (Model.Stats != null)
{
    <div class="row g-5 g-xl-8 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="card card-flush bgi-no-repeat bgi-size-contain bgi-position-x-end h-md-50 mb-5 mb-xl-10">
                <div class="card-header pt-5">
                    <div class="card-title d-flex flex-column">
                        <span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">@Model.Stats.Total</span>
                        <span class="text-gray-400 pt-1 fw-semibold fs-6">Total Applications</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card card-flush h-md-50 mb-5 mb-xl-10">
                <div class="card-header pt-5">
                    <div class="card-title d-flex flex-column">
                        <span class="fs-2hx fw-bold text-warning me-2 lh-1 ls-n2">@Model.Stats.Pending</span>
                        <span class="text-gray-400 pt-1 fw-semibold fs-6">Pending</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card card-flush h-md-50 mb-5 mb-xl-10">
                <div class="card-header pt-5">
                    <div class="card-title d-flex flex-column">
                        <span class="fs-2hx fw-bold text-info me-2 lh-1 ls-n2">@Model.Stats.UnderReview</span>
                        <span class="text-gray-400 pt-1 fw-semibold fs-6">Under Review</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card card-flush h-md-50 mb-5 mb-xl-10">
                <div class="card-header pt-5">
                    <div class="card-title d-flex flex-column">
                        <div class="d-flex">
                            <span class="fs-2hx fw-bold text-success me-2 lh-1 ls-n2">@Model.Stats.Approved</span>
                            <span class="fs-2hx fw-bold text-danger ms-3 lh-1 ls-n2">@Model.Stats.Rejected</span>
                        </div>
                        <span class="text-gray-400 pt-1 fw-semibold fs-6">Approved / Rejected</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-5"></i>
                <input type="text" data-kt-freelancer-table-filter="search" class="form-control form-control-solid w-250px ps-13" placeholder="Search by name or email" value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end" data-kt-freelancer-table-toolbar="base">
                <button type="button" class="btn btn-light-primary me-3" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                    <i class="ki-duotone ki-filter fs-2"></i>Filter
                </button>
                <div class="menu menu-sub menu-sub-dropdown w-300px w-md-325px" data-kt-menu="true">
                    <div class="px-7 py-5">
                        <div class="fs-5 text-dark fw-bold">Filter Options</div>
                    </div>
                    <div class="separator border-gray-200"></div>
                    <div class="px-7 py-5" data-kt-freelancer-table-filter="form">
                        <div class="mb-10">
                            <label class="form-label fs-6 fw-semibold">Status:</label>
                            <select class="form-select form-select-solid fw-bold" data-kt-select2="true" data-placeholder="Select status" data-allow-clear="true" data-kt-freelancer-table-filter="status" data-hide-search="true">
                                <option></option>
                                @foreach (FreelancerApplicationStatus status in Enum.GetValues(typeof(FreelancerApplicationStatus)))
                                {
                                    <option value="@status" selected="@(Model.StatusFilter == status)">@GetStatusDisplayName(status)</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="reset" class="btn btn-light btn-active-light-primary fw-semibold me-2 px-6" data-kt-menu-dismiss="true" data-kt-freelancer-table-filter="reset">Reset</button>
                            <button type="submit" class="btn btn-primary fw-semibold px-6" data-kt-menu-dismiss="true" data-kt-freelancer-table-filter="filter">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_freelancers">
            <thead>
                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                    <th class="min-w-125px">Name</th>
                    <th class="min-w-150px">Email</th>
                    <th class="min-w-125px">Phone</th>
                    <th class="min-w-125px">Availability</th>
                    <th class="min-w-100px">Status</th>
                    <th class="min-w-125px">Created Date</th>
                    <th class="text-end min-w-100px">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-600 fw-semibold">
                @if (Model.Applications != null && Model.Applications.Any())
                {
                    @foreach (var application in Model.Applications)
                    {
                        <tr>
                            <td>@application.FullName</td>
                            <td>@application.Email</td>
                            <td>@application.PhoneNumber</td>
                            <td>@GetAvailabilityDisplayName(application.Availability)</td>
                            <td>
                                <div class="badge @GetStatusBadgeClass(application.Status)">
                                    @GetStatusDisplayName(application.Status)
                                </div>
                            </td>
                            <td>@application.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-page="./Details" asp-route-id="@application.Id" class="btn btn-sm btn-light btn-active-light-primary">
                                    <i class="ki-duotone ki-eye fs-5 me-1"></i>View Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-10">
                            <div class="text-muted">No freelancer applications found.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var KTFreelancersList = function () {
            var table = document.querySelector('#kt_table_freelancers');
            var datatable;

            var initTable = function () {
                datatable = $(table).DataTable({
                    "info": false,
                    "order": [],
                    "pageLength": 10,
                    "lengthChange": false,
                    "columnDefs": [
                        { "orderable": false, "targets": 6 }
                    ]
                });

                datatable.on('draw', function () {
                    // Re-initialize any event handlers after table draw
                });
            };

            var handleSearchDatatable = function () {
                const filterSearch = document.querySelector('[data-kt-freelancer-table-filter="search"]');
                filterSearch.addEventListener('keyup', function (e) {
                    datatable.search(e.target.value).draw();
                });
            };

            var handleFilterDatatable = function () {
                const filterForm = document.querySelector('[data-kt-freelancer-table-filter="form"]');
                const filterButton = filterForm.querySelector('[data-kt-freelancer-table-filter="filter"]');
                const resetButton = filterForm.querySelector('[data-kt-freelancer-table-filter="reset"]');
                const selectOptions = filterForm.querySelectorAll('select');

                filterButton.addEventListener('click', function () {
                    var filterString = '';
                    selectOptions.forEach((item, index) => {
                        if (item.value && item.value !== '') {
                            if (index === 0) {
                                filterString += item.value;
                            } else {
                                filterString += " " + item.value;
                            }
                        }
                    });
                    datatable.search(filterString).draw();
                });

                resetButton.addEventListener('click', function () {
                    selectOptions.forEach(item => {
                        $(item).val(null).trigger('change');
                    });
                    datatable.search('').draw();
                });
            };

            return {
                init: function () {
                    initTable();
                    handleSearchDatatable();
                    handleFilterDatatable();
                }
            };
        }();

        $(document).ready(function() {
            KTFreelancersList.init();
        });
    </script>
}

@functions {
    private string GetStatusBadgeClass(FreelancerApplicationStatus status) => status switch
    {
        FreelancerApplicationStatus.Pending => "badge-light-warning",
        FreelancerApplicationStatus.UnderReview => "badge-light-info",
        FreelancerApplicationStatus.Approved => "badge-light-success",
        FreelancerApplicationStatus.Rejected => "badge-light-danger",
        _ => "badge-light-secondary"
    };

    private string GetStatusDisplayName(FreelancerApplicationStatus status) => status switch
    {
        FreelancerApplicationStatus.Pending => "Pending",
        FreelancerApplicationStatus.UnderReview => "Under Review",
        FreelancerApplicationStatus.Approved => "Approved",
        FreelancerApplicationStatus.Rejected => "Rejected",
        _ => status.ToString()
    };

    private string GetAvailabilityDisplayName(FreelancerAvailability availability) => availability switch
    {
        FreelancerAvailability.FullTimeFreelance => "Full-Time Freelance",
        FreelancerAvailability.PartTimeFreelance => "Part-Time Freelance",
        FreelancerAvailability.ProjectBased => "Project-Based",
        _ => availability.ToString()
    };
}
