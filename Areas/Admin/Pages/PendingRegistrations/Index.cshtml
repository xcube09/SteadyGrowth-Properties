@page
@model SteadyGrowth.Web.Areas.Admin.Pages.PendingRegistrations.IndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@{
    ViewData["Title"] = "Pending Registrations";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-5"></i>
                <input type="text" id="searchInput" class="form-control form-control-solid w-250px ps-13" placeholder="Search by name or email" value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end">
                <select id="statusFilter" class="form-select form-select-solid w-200px me-3">
                    @{
                        var statuses = new[] { ("", "All Status"), ("Pending", "Pending"), ("Approved", "Approved"), ("Rejected", "Rejected") };
                    }
                    @foreach (var s in statuses)
                    {
                        if (Model.StatusFilter == s.Item1 || (string.IsNullOrEmpty(Model.StatusFilter) && s.Item1 == ""))
                        {
                            <option value="@s.Item1" selected>@s.Item2</option>
                        }
                        else
                        {
                            <option value="@s.Item1">@s.Item2</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-light-primary" onclick="applyFilters()">
                    <i class="ki-duotone ki-filter fs-2"></i>Apply Filter
                </button>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <div class="mb-3">
            <span class="text-muted">Showing @Model.TotalCount registration(s)</span>
        </div>
        <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_pending_registrations_table">
            <thead>
                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                    <th class="min-w-150px">Applicant</th>
                    <th class="min-w-125px">Package</th>
                    <th class="min-w-100px">Referral Code</th>
                    <th class="min-w-100px">Status</th>
                    <th class="min-w-125px">Submitted</th>
                    <th class="text-end min-w-100px">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-600 fw-semibold">
                @if (Model.Registrations != null && Model.Registrations.Any())
                {
                    @foreach (var reg in Model.Registrations)
                    {
                        <tr data-id="@reg.Id">
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-gray-800 fw-bold">@reg.FullName</span>
                                    <span class="text-muted small">@reg.Email</span>
                                    @if (!string.IsNullOrEmpty(reg.PhoneNumber))
                                    {
                                        <span class="text-muted small">@reg.PhoneNumber</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-light-@(reg.PackageName.Contains("Premium") ? "success" : "primary") fw-bold">@reg.PackageName</span>
                                <br />
                                <span class="text-muted small">$@reg.PackagePrice.ToString("N0")</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(reg.ReferralCode))
                                {
                                    <span class="badge badge-light-info">@reg.ReferralCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td>
                                <div class="badge badge-light-@GetStatusColor(reg.Status) fw-bold">@reg.Status</div>
                                @if (reg.ProcessedAt.HasValue)
                                {
                                    <br />
                                    <span class="text-muted small">@reg.ProcessedAt.Value.ToShortDateString()</span>
                                }
                            </td>
                            <td>@reg.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-end">
                                @if (reg.Status == "Pending")
                                {
                                    <button type="button" class="btn btn-sm btn-success me-1" onclick="approveRegistration(@reg.Id, '@reg.FullName')">
                                        <i class="ki-duotone ki-check fs-4"></i> Approve
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="rejectRegistration(@reg.Id, '@reg.FullName')">
                                        <i class="ki-duotone ki-cross fs-4"></i> Reject
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-light-danger" onclick="deleteRegistration(@reg.Id)">
                                        <i class="ki-duotone ki-trash fs-4"></i> Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-10">
                            <div class="d-flex flex-column align-items-center">
                                <i class="ki-duotone ki-user-tick fs-3x text-muted mb-5"></i>
                                <span class="text-muted fs-6">No pending registrations found</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reject Registration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rejectRegistrationId" />
                <p>Are you sure you want to reject the registration for <strong id="rejectUserName"></strong>?</p>
                <div class="mb-3">
                    <label class="form-label">Reason (optional)</label>
                    <textarea class="form-control" id="rejectReason" rows="3" placeholder="Enter rejection reason..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmReject()">Reject</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Search on Enter key
        document.getElementById('searchInput').addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                applyFilters();
            }
        });

        function applyFilters() {
            const search = document.getElementById('searchInput').value;
            const status = document.getElementById('statusFilter').value;
            const url = new URL(window.location);

            if (search) {
                url.searchParams.set('search', search);
            } else {
                url.searchParams.delete('search');
            }

            if (status) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }

            window.location.href = url.toString();
        }

        function approveRegistration(id, name) {
            Swal.fire({
                title: 'Approve Registration',
                html: `Are you sure you want to approve the registration for <strong>${name}</strong>?<br/><br/>This will create a user account and process any referral commissions.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#50cd89',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Approve',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('?handler=Approve', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ id: id })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Approved!',
                                text: data.message,
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while approving the registration.'
                        });
                    });
                }
            });
        }

        function rejectRegistration(id, name) {
            document.getElementById('rejectRegistrationId').value = id;
            document.getElementById('rejectUserName').textContent = name;
            document.getElementById('rejectReason').value = '';
            var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }

        function confirmReject() {
            const id = document.getElementById('rejectRegistrationId').value;
            const reason = document.getElementById('rejectReason').value;

            fetch('?handler=Reject', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: parseInt(id), reason: reason })
            })
            .then(response => response.json())
            .then(data => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('rejectModal'));
                modal.hide();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Rejected',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while rejecting the registration.'
                });
            });
        }

        function deleteRegistration(id) {
            Swal.fire({
                title: 'Delete Registration',
                text: 'Are you sure you want to delete this registration record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f1416c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('?handler=Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ id: id })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted',
                                text: data.message,
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while deleting the registration.'
                        });
                    });
                }
            });
        }
    </script>
    @functions {
        private string GetStatusColor(string status) => status switch {
            "Pending" => "warning",
            "Approved" => "success",
            "Rejected" => "danger",
            _ => "secondary"
        };
    }
}
