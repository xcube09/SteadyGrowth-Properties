@page
@model FreelancerApplicationSuccessModel
@{
    ViewData["Title"] = "Application Submitted Successfully";
}

<!-- SUCCESS MESSAGE AREA START -->
<div class="ltn__about-us-area pt-120 pb-120">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="ltn__form-box contact-form-box box-shadow white-bg text-center p-5">
                    <div class="mb-30">
                        <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
                    </div>
                    <h2 class="mb-20">Thank You for Your Application!</h2>
                    <p class="mb-30" style="font-size: 16px;">
                        Your freelancer registration application has been submitted successfully.
                        Our team will review your application and contact you within 3-5 business days.
                    </p>
                    <div class="section-bg-1 p-4 mb-30" style="border-radius: 8px;">
                        <h5 class="mb-15">What Happens Next?</h5>
                        <ul class="text-start" style="list-style-type: disc; padding-left: 30px;">
                            <li class="mb-10">Our recruitment team will review your application</li>
                            <li class="mb-10">You will receive an email confirmation shortly</li>
                            <li class="mb-10">If shortlisted, we will contact you for an interview</li>
                            <li class="mb-10">Successful candidates will receive onboarding information</li>
                        </ul>
                    </div>
                    <p class="mb-30">
                        If you have any questions in the meantime, please don't hesitate to contact us.
                    </p>
                    <div class="btn-wrapper">
                        <a href="/" class="btn theme-btn-1 btn-effect-1 text-uppercase me-2">
                            <i class="fas fa-home me-2"></i>Back to Home
                        </a>
                        <a asp-page="/Contact" class="btn theme-btn-2 btn-effect-2 text-uppercase">
                            <i class="fas fa-envelope me-2"></i>Contact Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- SUCCESS MESSAGE AREA END -->
