@page
@model SteadyGrowth.Web.Pages.ServicesModel
@{
    ViewData["Title"] = "Our Services";
}



<!-- OUR SERVICES SHOWCASE START -->
<div class="ltn__about-us-area pt-60 pb-60">
    <div class="container">
        <!-- Section Title -->
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center mb-50">
                    <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">What We Do</h6>
                    <h1 class="section-title">Our Services</h1>
                    <p>Delivering excellence across every aspect of real estate</p>
                </div>
            </div>
        </div>

        <!-- Property Development -->
        <div class="row mb-60">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-img-wrap ltn__img-shape-left about-img-left">
                    <img src="/images/services/property-development.png" alt="Property Development"
                         style="width: 100%; height: auto; max-width: 800px;">
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h3 class="section-title">Property Development</h3>
                        <p>
                            We pride ourselves in creating unique and sustainable properties that set new benchmarks 
                            in design, quality, and sustainability. Our comprehensive property development services 
                            cover every aspect from initial concept to final handover, with award-winning architects 
                            and designers ensuring every project is aesthetically pleasing and functional.
                        </p>
                    </div>
                    <div class="btn-wrapper">
                        <a href="#" class="theme-btn-1 btn btn-effect-1">Learn More</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shortlets -->
        <div class="row mb-60">
            <div class="col-lg-6 align-self-center order-lg-2">
                <div class="about-us-img-wrap about-img-right">
                    <img src="/images/services/shortlets.png" alt="Shortlets"
                         style="width: 100%; height: auto; max-width: 800px;">
                </div>
            </div>
            <div class="col-lg-6 align-self-center order-lg-1">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h3 class="section-title">Shortlets</h3>
                        <p>
                            Experience true comfort and serenity with our luxurious short let apartments. 
                            Perfect for tourists, business travelers, or anyone seeking to unwind in style. 
                            Our premium shortlet properties offer all the amenities of home with the luxury 
                            of a five-star hotel experience.
                        </p>
                    </div>
                    <div class="btn-wrapper">
                        <a href="#" class="theme-btn-1 btn btn-effect-1">View Properties</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Land Banking -->
        <div class="row mb-60">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-img-wrap ltn__img-shape-left about-img-left">
                    <img src="/images/services/land-banking.png" alt="Land Banking"
                         style="width: 100%; height: auto; max-width: 800px;">
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h3 class="section-title">Land Banking</h3>
                        <p>
                            Unlock the potential of prime real estate with our expert land banking services. 
                            We help you invest in strategically positioned land parcels in Abuja and beyond 
                            that promise high returns. Our team identifies locations with the highest growth 
                            potential for maximum investment returns.
                        </p>
                    </div>
                    <div class="btn-wrapper">
                        <a href="#" class="theme-btn-1 btn btn-effect-1">Explore Opportunities</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Brokerage -->
        <div class="row mb-60">
            <div class="col-lg-6 align-self-center order-lg-2">
                <div class="about-us-img-wrap about-img-right">
                    <img src="/images/services/brokerage.png" alt="Brokerage"
                         style="width: 100%; height: auto; max-width: 800px;">
                </div>
            </div>
            <div class="col-lg-6 align-self-center order-lg-1">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h3 class="section-title">Brokerage</h3>
                        <p>
                            Experience seamless real estate transactions with our premium brokerage services. 
                            Whether you're looking to buy, sell, or lease property, our expert brokers provide 
                            personalized guidance through every step of the process, ensuring you get the best 
                            deals and smooth transactions.
                        </p>
                    </div>
                    <div class="btn-wrapper">
                        <a href="#" class="theme-btn-1 btn btn-effect-1">Connect with Brokers</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SteadyGrowth Academy -->
        <div class="row mb-60">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-img-wrap ltn__img-shape-left about-img-left">
                    <img src="/images/services/academy.png" alt="SteadyGrowth Academy"
                         style="width: 100%; height: auto; max-width: 800px;">
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h3 class="section-title">SteadyGrowth Academy</h3>
                        <h6 class="section-subtitle ltn__secondary-color mb-3">
                            The #1 Success and Real Estate Learning Platform
                        </h6>
                        <p>
                            Empowering individuals for real estate success through comprehensive training, 
                            mentorship, and practical knowledge. Our academy provides cutting-edge courses, 
                            expert-led workshops, and hands-on experience to help you thrive in the real 
                            estate industry.
                        </p>
                    </div>
                    <div class="btn-wrapper">
                        <a href="#" class="theme-btn-1 btn btn-effect-1">Join Academy</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- OUR SERVICES SHOWCASE END -->
