<!-- MISSION VISION VALUES AREA START -->
<div class="ltn__about-us-area pt-115 pb-90">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center mb-50">
                    <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">Our Foundation</h6>
                    <h1 class="section-title">Mission, Vision & Values</h1>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- Mission -->
            <div class="col-lg-4 col-md-6 mb-30">
                <div class="ltn__feature-item ltn__feature-item-6 text-center bg-white box-shadow-1 h-100">
                    <div class="about-us-img-wrap mb-30">
                        <img src="/images/about/our-mission.jpg" alt="Our Mission" class="img-fluid">
                    </div>
                    <div class="ltn__feature-info px-4 pb-4">
                        <h3 class="mb-3"><a href="#">Our Mission</a></h3>
                        <p>
                            To revolutionize real estate in Nigeria by providing exceptional properties that combine 
                            luxury with affordability, while empowering our clients to build lasting wealth through 
                            strategic property investments and comprehensive support services.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Vision -->
            <div class="col-lg-4 col-md-6 mb-30">
                <div class="ltn__feature-item ltn__feature-item-6 text-center bg-white box-shadow-1 h-100">
                    <div class="about-us-img-wrap mb-30">
                        <img src="/images/about/our-vision.jpg" alt="Our Vision" class="img-fluid">
                    </div>
                    <div class="ltn__feature-info px-4 pb-4">
                        <h3 class="mb-3"><a href="#">Our Vision</a></h3>
                        <p>
                            To be the leading real estate company in Africa, recognized for transforming lives through 
                            innovative property solutions, sustainable development practices, and creating communities 
                            where dreams flourish and legacies are built.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Values -->
            <div class="col-lg-4 col-md-6 mb-30">
                <div class="ltn__feature-item ltn__feature-item-6 text-center bg-white box-shadow-1 h-100">
                    <div class="about-us-img-wrap mb-30">
                        <img src="/images/about/our-values.jpg" alt="Our Values" class="img-fluid">
                    </div>
                    <div class="ltn__feature-info px-4 pb-4">
                        <h3 class="mb-3"><a href="#">Our Values</a></h3>
                        <p>
                            Excellence in every detail, integrity in all dealings, innovation in our approach, 
                            sustainability in development, and commitment to client success. We believe in building 
                            not just properties, but lasting relationships and thriving communities.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- MISSION VISION VALUES AREA END -->
